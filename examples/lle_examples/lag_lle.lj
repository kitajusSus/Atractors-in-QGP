using LinearAlgebra
using Statistics
using CairoMakie

function kula_3d_w_15d(N)
    T = randn(Float64, 3, N)
    X = zeros(Float64, 15, N)
    
    X[1:3, :] .= T
    X[4, :] .= sin.(T[1, :])
    X[5, :] .= T[2, :] .^ 2
    X[6, :] .= exp.(.-abs.(T[3, :]))
    
    A = randn(Float64, 9, 3)
    X[7:15, :] .= A * T
    
    X .+= 0.05 .* randn(Float64, 15, N)
    return X
end

function oblicz_macierz_odleglosci(X)
    N = size(X, 2)
    D = zeros(Float64, N, N)
    for i in 1:N
        for j in (i+1):N
            d = norm(X[:, i] - X[:, j])
            D[i, j] = d
            D[j, i] = d
        end
    end
    return D
end

function oblicz_blad_rekonstrukcji(X, D, K)
    d, N = size(X)
    blad_calkowity = 0.0
    
    for i in 1:N
        x_i = X[:, i]
        
        idx_sasiadow = sortperm(D[:, i])[2:K+1]
        S_i = X[:, idx_sasiadow]
        
        Z = S_i .- x_i
        C = Z' * Z
        
        ladunek_reg = 1e-12 * tr(C) + 1e-15
        C_reg = C + ladunek_reg * I
        
        y = C_reg \ ones(Float64, K)
        
        w = y ./ sum(y)
        
        blad_lokalny = dot(w, C * w)
        blad_calkowity += blad_lokalny
    end
    
    return blad_calkowity / N
end

function analizuj_bledy_K(X, K_zakres)
    D = oblicz_macierz_odleglosci(X)
    
    liczba_K = length(K_zakres)
    bledy = zeros(Float64, liczba_K)
    
    for (idx, K) in enumerate(K_zakres)
        bledy[idx] = oblicz_blad_rekonstrukcji(X, D, K)
    end
    
    dP = diff(bledy)
    d2P = diff(dP)
    
    indeks_lokcia = argmax(d2P) + 1
    optymalne_K = K_zakres[indeks_lokcia]
    
    return bledy, dP, d2P, optymalne_K
end

function rysuj_analize_kinematyki(K_zakres, bledy, dP, optymalne_K)
    fig = Figure(size = (1000, 500))
    
    ax1 = Axis(fig[1, 1], 
        title = "Sredni blad rekonstrukcji w funkcji K",
        xlabel = "Liczba sasiadow K", 
        ylabel = "Blad"
    )
    lines!(ax1, K_zakres, bledy, color = :blue, linewidth = 2)
    scatter!(ax1, K_zakres, bledy, color = :blue, markersize = 8)
    vlines!(ax1, [optymalne_K], color = :red, linestyle = :dash)
    
    K_pochodna = K_zakres[2:end]
    ax2 = Axis(fig[1, 2], 
        title = "Pierwsza pochodna bledu (Spadek)",
        xlabel = "Liczba sasiadow K", 
        ylabel = "Roznica bledu Δϵ"
    )
    lines!(ax2, K_pochodna, dP, color = :orange, linewidth = 2)
    scatter!(ax2, K_pochodna, dP, color = :orange, markersize = 8)
    vlines!(ax2, [optymalne_K], color = :red, linestyle = :dash)
    
    display(fig)
    return fig
end

X_kula = kula_3d_w_15d(1000)
K_testowane = 3:1:30

bledy_rekonstrukcji, pierwsza_pochodna, _, k_opt = analizuj_bledy_K(X_kula, K_testowane)
rysuj_analize_kinematyki(K_testowane, bledy_rekonstrukcji, pierwsza_pochodna, k_opt)
